---
/**
 * Hero.
 *
 * Duas coisas acontecem aqui e nenhuma e enfeite. A primeira: as 36 trilhas do
 * isotipo acendem em cascata do centro para fora, na ordem que o script de marca
 * calculou por distancia do nucleo (atributo --i). A placa parece energizar.
 *
 * A segunda: uma linha de ECG fecha o bloco, com um cabecote varrendo o traco.
 * A tagline promete uptime, entao o sinal vital fica visivel na pagina em vez de
 * so escrito. Esse traco e desenhado aqui, nao vem do logo.
 */
import { ui, type Locale } from '../i18n/ui';
import isotipo from '../assets/brand/isotipo.svg?raw';

interface Props {
  locale: Locale;
}

const t = ui[Astro.props.locale].hero;

/**
 * Um ciclo de ECG, em coordenadas relativas: linha de base, onda P, complexo
 * QRS, linha de base, onda T, linha de base de novo. Cento e vinte unidades de
 * ponta a ponta, comecando e terminando na mesma altura, o que permite repetir
 * lado a lado sem emenda visivel.
 *
 * Relativo, e nao absoluto, porque o mesmo desenho serve a duas coisas: o traco
 * na tela e o trilho por onde o cabecote corre.
 */
const CICLO = 'h30 l4 -1 3 2 4 -14 5 27 4 -14 3 3 4 -3 h15 q6 0 9 -7 3 -7 6 0 3 7 9 7 h24';

/**
 * O traco visivel. Oito ciclos.
 *
 * O numero vem da geometria, nao de gosto: a faixa cabe no maximo 771 unidades
 * do viewBox (1080px de largura util divididos pela escala de 1.4), e o cabecote
 * viaja no maximo 720. Oito ciclos dao 960 unidades e cobrem os dois com folga.
 */
const FITA = `M0 20 ${CICLO.repeat(8)}`;

/**
 * A geometria do ciclo, ponto a ponto, na ordem em que o traco a percorre.
 * Os tres trechos com tres pontos sao as curvas quadraticas da onda T.
 */
const VERTICES: Array<[number, number] | [number, number, number, number]> = [
  [30, 20], [34, 19], [37, 21], [41, 7], [46, 34], [50, 20], [53, 23], [57, 20], [72, 20],
  [78, 20, 81, 13], // curva: controle e fim
  [84, 6, 87, 13],
  [90, 20, 96, 20],
  [120, 20],
];

/**
 * Altura da onda em funcao do avanco horizontal.
 *
 * Por que nao usar offset-path, que seria uma linha de CSS: naquele modelo o
 * elemento avanca por COMPRIMENTO DE ARCO, e nao por X. No complexo QRS a curva
 * sobe 27 unidades em 5 de largura, entao ali o cabecote gasta muito percurso
 * andando quase nada na horizontal, enquanto o avanco segue em velocidade
 * constante. Medido: os dois chegavam a 12.7 unidades fora de fase, e justamente
 * nos picos, que e onde o olho repara.
 *
 * Amostrando a altura em passos iguais de X, o avanco horizontal volta a ser
 * linear e casa exatamente com o deslocamento do grupo de avanco.
 */
function alturaPorX(): Array<{ x: number; y: number }> {
  const pontos: Array<{ x: number; y: number }> = [{ x: 0, y: 20 }];
  let [px, py] = [0, 20];

  for (const v of VERTICES) {
    if (v.length === 2) {
      /*
       * Trecho reto: basta o vertice final. Entre dois quadros o CSS interpola
       * em linha reta, que e exatamente a forma do segmento, entao acrescentar
       * pontos no meio nao ganharia precisao nenhuma.
       *
       * Uma versao anterior reamostrava tudo em passos iguais de X, e isso saia
       * pior: com um ponto a cada duas unidades, os vertices do complexo QRS
       * (x=41 e x=46, onde a onda vira) caiam entre amostras e eram cortados, o
       * que tirava o cabecote do traco justamente no pico.
       */
      const [x, y] = v;
      pontos.push({ x, y });
      [px, py] = [x, y];
      continue;
    }

    // Curva quadratica: amostrada, porque nenhuma reta a reproduz.
    const [cx, cy, x, y] = v;
    for (let i = 1; i <= 12; i++) {
      const t = i / 12;
      const u = 1 - t;
      pontos.push({
        x: u * u * px + 2 * u * t * cx + t * t * x,
        y: u * u * py + 2 * u * t * cy + t * t * y,
      });
    }
    [px, py] = [x, y];
  }

  return pontos;
}

/**
 * A oscilacao vertical do cabecote: um ciclo, so o Y.
 *
 * Este e o conserto estrutural do defeito que voltou tres vezes. Antes um unico
 * conjunto de quadros carregava X e Y juntos, entao cada largura de tela exigia
 * o seu proprio keyframe gigante, e qualquer erro no numero de ciclos tirava o
 * ponto de cima da onda ou o fazia sumir no meio da faixa.
 *
 * Separando os dois eixos em grupos aninhados, o Y passa a ser um ciclo unico
 * que se repete para sempre, e o X vira uma reta. A fase casa sozinha porque a
 * duracao do avanco e sempre um multiplo inteiro da duracao da onda: nao ha como
 * os dois sairem de sincronia sem que alguem mude os dois numeros ao mesmo tempo,
 * e ha teste para isso.
 *
 * O Y e absoluto no sistema do SVG. Os circulos ficam em cy=0, entao descontar
 * as 20 unidades da linha de base faria o cabecote correr acima do traco.
 */
const QUADROS_ONDA = alturaPorX()
  .map(({ x, y }) => `${((x / 120) * 100).toFixed(3)}% { translate: 0 ${y.toFixed(2)}px; }`)
  .join('\n');

/**
 * O avanco horizontal, uma reta por faixa de largura.
 *
 * Quantos ciclos cabem na tela e o unico numero que depende do tamanho do
 * aparelho. A faixa vive dentro da casca, entao a largura util vai de 272px num
 * aparelho de 320 ate 1080px travados a partir de 74rem. Com o encaixe "slice" a
 * escala e sempre 1.4 (a altura de 56px sobre as 40 unidades do viewBox manda em
 * qualquer largura util abaixo de 2016px), logo cada ciclo ocupa 168px fixos.
 *
 * Os cortes saem dai: o percurso precisa ficar entre 0.84 e 1.26 vezes a largura
 * util. Abaixo disso o ponto morre em area opaca e some do nada, que era a
 * queixa; acima, passa tempo demais fora do quadro.
 */
const CICLOS = [2, 3, 4, 5, 6];
const QUADROS_AVANCO = CICLOS.map(
  (n) => `@keyframes avanco-${n} {
  from { translate: 0; }
  to { translate: ${n * 120}px; }
}`,
).join('\n');

/**
 * O comprimento do rastro, em unidades do viewBox.
 *
 * Dois ciclos e meio: o bastante para o brilho cobrir um batimento inteiro mais
 * a linha de base antes dele, entao o QRS aceso nunca fica cortado ao meio.
 */
const RASTRO = 300;
---

<section class="hero">
  <div class="casca hero-grade">
    <div class="hero-texto">
      <p class="hero-kicker">
        <span class="hero-ponto" aria-hidden="true"></span>
        {t.kicker}
      </p>

      <h1 class="hero-titulo">{t.titulo}</h1>

      <p class="hero-descricao">{t.texto}</p>

      <div class="hero-acoes">
        <a class="botao botao-primario" href="#projetos">
          {t.acaoPrimaria}
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
          </svg>
        </a>
        <a class="botao botao-secundario" href="#contato">{t.acaoSecundaria}</a>
      </div>
    </div>

    <figure class="hero-figura">
      <div class="hero-marca" set:html={isotipo} />
      <figcaption class="oculto-visual">{t.legendaFigura}</figcaption>
    </figure>
  </div>

  <!--
    Sinal vital.

    Fica dentro da casca de proposito. Solto na secao ele atravessava a janela
    inteira enquanto todo o resto da pagina para em 74rem, e a borda superior
    virava um risco de ponta a ponta que nao pertencia a nenhum bloco. Alinhado a
    coluna de conteudo ele le como o rodape do hero, que e o que e.

    O encaixe e "slice" e nao "none". Com "none" o desenho e esticado para caber
    na largura disponivel, entao numa tela estreita os mesmos 1440 de viewBox
    comprimiam quase quatro vezes na horizontal e alongavam na vertical: os
    batimentos viravam espetos amontoados. Com "slice" a proporcao e preservada e
    o que sobra e cortado, exatamente como um monitor de verdade, que mostra
    menos batimentos numa tela menor em vez de espremer os mesmos.
  -->
  <div class="casca">
    <div class="ecg" aria-hidden="true">
      <svg class="ecg-svg" viewBox="0 0 1440 40" preserveAspectRatio="xMinYMid slice" focusable="false">
        <defs>
          <!--
            O rastro de fosforo. O gradiente vive em userSpaceOnUse alinhado ao
            proprio retangulo, entao quando o retangulo anda o brilho anda junto,
            sem que nenhuma conta precise repetir a posicao do cabecote.
          -->
          <linearGradient id="ecg-brilho" gradientUnits="userSpaceOnUse" x1={-RASTRO} y1="0" x2="0" y2="0">
            <stop offset="0%" stop-color="#fff" stop-opacity="0" />
            <stop offset="62%" stop-color="#fff" stop-opacity="0.2" />
            <stop offset="100%" stop-color="#fff" stop-opacity="1" />
          </linearGradient>
          <mask id="ecg-rastro" maskUnits="userSpaceOnUse" x="-400" y="0" width="2400" height="40">
            <g class="ecg-rastro">
              <rect x={-RASTRO} y="0" width={RASTRO} height="40" fill="url(#ecg-brilho)" />
            </g>
          </mask>
        </defs>

        <!--
          O traco entra duas vezes. O de baixo fica sempre visivel e apagado, e e
          o que da contexto: sem ele a faixa ficaria vazia a frente do cabecote. O
          de cima e o mesmo desenho aceso, recortado pela mascara do rastro, entao
          so aparece no trecho que o cabecote acabou de percorrer.
        -->
        <path class="ecg-traco" d={FITA} />
        <path class="ecg-traco ecg-traco-vivo" d={FITA} mask="url(#ecg-rastro)" />

        <!--
          Dois grupos, um por eixo. O de fora anda em X, o de dentro sobe e desce
          em Y. Aninhados, os dois "translate" compoem sem que nenhum precise
          conhecer o outro.
        -->
        <g class="ecg-avanco">
          <g class="ecg-cabecote">
            <circle class="ecg-halo" r="5.5" />
            <circle class="ecg-ponto" r="2.4" />
          </g>
        </g>
      </svg>
    </div>
  </div>

  <!--
    Os quadros sao calculados no build, e nao escritos a mao: eles dependem da
    geometria da onda, entao mudar o desenho do ciclo recalcula a animacao
    sozinho. Vao numa folha propria porque o bloco <style> do Astro e estatico e
    nao aceita interpolacao.
  -->
  <style
    is:inline
    set:html={`@keyframes onda {
${QUADROS_ONDA}
}
${QUADROS_AVANCO}`}
  />
</section>

<script>
  /**
   * Mantem o sinal vital vivo para quem pediu menos movimento.
   *
   * O Chromium zera a duracao de toda animacao DECLARADA EM CSS enquanto
   * prefers-reduced-motion esta ligado: medido, animation-duration computa
   * 1e-06s e a faixa congela no primeiro quadro. A Web Animations API nao sofre
   * esse corte, o que da a unica saida possivel para continuar mostrando um
   * batimento sem desrespeitar a intencao de quem ligou a preferencia.
   *
   * O acordo e a cadencia: o percurso e o mesmo, o ritmo cai pela metade. A
   * preferencia existe por causa de deslocamento amplo, parallax e zoom, e nao
   * por um ponto de 2.4px atravessando um rodape devagar.
   *
   * Sem JavaScript nada disso roda e o CSS assume: a faixa fica parada com o
   * cabecote pousado sobre a linha de base, que ja e uma imagem honesta. Este
   * script so melhora o que ja funciona.
   */
  (() => {
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)');
    const faixa = document.querySelector<HTMLElement>('.ecg');
    if (!faixa) return;

    const avanco = faixa.querySelector<SVGGElement>('.ecg-avanco');
    const rastro = faixa.querySelector<SVGGElement>('.ecg-rastro');
    const cabecote = faixa.querySelector<SVGGElement>('.ecg-cabecote');
    if (!avanco || !cabecote) return;

    /**
     * Le os quadros de um @keyframes que ja existe na folha de estilo.
     *
     * Reaproveitar e o ponto: a forma da onda e calculada no build a partir da
     * geometria do traco, e reescreve-la aqui criaria um segundo lugar para ela
     * divergir. O que o CSS anima e o que este script anima, por construcao.
     */
    const lerQuadros = (nome: string): Keyframe[] | null => {
      for (const folha of document.styleSheets) {
        let regras: CSSRuleList;
        try {
          regras = folha.cssRules;
        } catch {
          continue; // folha de outra origem, nao ha o que ler
        }
        for (const regra of regras) {
          if (regra instanceof CSSKeyframesRule && regra.name === nome) {
            return [...regra.cssRules]
              .filter((q): q is CSSKeyframeRule => q instanceof CSSKeyframeRule)
              .map((q) => ({
                offset: Number.parseFloat(q.keyText) / 100,
                translate: q.style.translate,
              }))
              .sort((a, b) => (a.offset as number) - (b.offset as number));
          }
        }
      }
      return null;
    };

    let ativas: Animation[] = [];
    const desmontar = () => {
      for (const a of ativas) a.cancel();
      ativas = [];
    };

    const montar = () => {
      desmontar();
      if (!semMovimento.matches) return; // sem a preferencia, o CSS ja anima

      const estilo = getComputedStyle(faixa);
      const ciclos = Number.parseInt(estilo.getPropertyValue('--ciclos'), 10) || 2;
      const batida = (Number.parseFloat(estilo.getPropertyValue('--batida')) || 1.25) * 1000;

      const onda = lerQuadros('onda');
      const percurso = lerQuadros(`avanco-${ciclos}`);
      if (!onda || !percurso) return; // folha ausente: fica a parada do CSS

      /* Metade do ritmo. O percurso continua inteiro, so leva o dobro do tempo. */
      const LENTO = 2;
      const comum = { iterations: Infinity, easing: 'linear' } as const;

      for (const alvo of [avanco, rastro]) {
        if (!alvo) continue;
        ativas.push(
          alvo.animate(percurso, { ...comum, duration: ciclos * batida * LENTO }),
        );
      }
      ativas.push(cabecote.animate(onda, { ...comum, duration: batida * LENTO }));
    };

    montar();

    /*
     * A largura muda o --ciclos, que muda o percurso: sem remontar, o cabecote
     * passaria a correr uma distancia que nao corresponde mais a faixa.
     */
    let pendente = 0;
    addEventListener(
      'resize',
      () => {
        clearTimeout(pendente);
        pendente = window.setTimeout(montar, 200);
      },
      { passive: true },
    );

    semMovimento.addEventListener('change', montar);
  })();
</script>

<style>
  .hero {
    position: relative;
    padding-block: var(--s8) 0;
    overflow: hidden;
  }

  @media (min-width: 60rem) {
    .hero {
      padding-block-start: var(--s9);
    }
  }

  .hero-grade {
    display: grid;
    gap: var(--s7);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grade {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--s8);
    }
  }

  /* ------------------------------------------------------------- texto - */

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-3);
  }

  .hero-ponto {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--menta);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--menta) 55%, transparent);
    animation: batida 2.4s var(--curva) infinite;
  }

  @keyframes batida {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--menta) 45%, transparent);
    }
    60%,
    100% {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }

  .hero-titulo {
    margin-block-start: var(--s5);
    font-size: clamp(2.5rem, 1.2rem + 5.4vw, 4.75rem);
    font-stretch: 96%;
    letter-spacing: -0.025em;
    line-height: 0.97;
    text-wrap: balance;
    max-width: 15ch;
  }

  .hero-descricao {
    margin-block-start: var(--s5);
    max-width: 54ch;
    font-size: 1.0625rem;
    color: var(--texto-2);
  }

  @media (min-width: 48rem) {
    .hero-descricao {
      font-size: 1.125rem;
    }
  }

  .hero-acoes {
    margin-block-start: var(--s6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }

  /* ------------------------------------------------------------- marca - */

  .hero-figura {
    margin: 0;
    justify-self: center;
    width: min(20rem, 68vw);
  }

  @media (min-width: 60rem) {
    .hero-figura {
      width: min(24rem, 100%);
    }
  }

  .hero-marca :global(svg) {
    width: 100%;
    height: auto;
    /* O brilho e discreto: separa o simbolo do fundo sem virar neon. */
    filter: drop-shadow(0 0 2.5rem color-mix(in srgb, var(--ciano) 16%, transparent));
  }

  /*
   * A cascata. Cada trilha carrega --i, o proprio indice ordenado por distancia
   * do centro, entao o atraso cresce do nucleo para a borda.
   */
  .hero-marca :global(.sl-trace) {
    opacity: 0;
    animation: acender 620ms var(--curva) forwards;
    animation-delay: calc(var(--i, 0) * 24ms + 160ms);
  }

  @keyframes acender {
    0% {
      opacity: 0;
    }
    35% {
      opacity: 1;
      filter: brightness(2.2);
    }
    100% {
      opacity: 1;
      filter: brightness(1);
    }
  }

  /* A trilha do nucleo carrega a linha de batimento: ela continua pulsando. */
  .hero-marca :global(#sl-core) {
    animation:
      acender 620ms var(--curva) forwards,
      nucleo 3.2s var(--curva) 1.1s infinite;
  }

  @keyframes nucleo {
    0%,
    72%,
    100% {
      filter: brightness(1);
    }
    78% {
      filter: brightness(1.75);
    }
  }

  /* --------------------------------------------------------------- ecg - */

  .ecg {
    /*
     * A batida do coracao desenhado. Um ciclo por 1.25s da 48 por minuto: repouso
     * tranquilo, presente sem agitar a pagina. Tudo no ECG deriva daqui, entao
     * mudar a cadencia e mexer num numero so, e nada sai de fase.
     */
    --batida: 1.25s;

    /*
     * Quantos ciclos o cabecote atravessa. Mora aqui, e nao no grupo que anda,
     * porque a mascara tambem precisa dele: os dois descrevem o mesmo percurso.
     */
    --ciclos: 2;

    /* A altura da faixa, nomeada porque o --fim precisa dela para a conta. */
    --altura: 3.5rem;

    /*
     * Onde o cabecote morre, derivado da geometria e nao escrito a mao.
     *
     * O viewBox mostra 40 unidades de altura e o ciclo tem 120 de largura, entao
     * cada ciclo ocupa exatamente tres vezes a area de CONTEUDO da faixa, que e
     * a altura menos a borda superior sob border-box.
     *
     * Nao vale fixar em pixels. Medido no Chrome com o Windows em 125%, a borda
     * de 1px computa 0.8px e a escala vai de 1.375 para 1.380: um --fim cravado
     * em 165px por ciclo erra 3.6px numa faixa de 1080 e passa a errar mais
     * conforme o zoom. Derivando, a conta acompanha sozinha.
     */
    --fim: calc(var(--ciclos) * 3 * (var(--altura) - var(--borda)));

    /*
     * O comprimento do apagamento, igual nas duas pontas.
     *
     * Eram 2.5rem na entrada e 3.5rem na saida, e a diferenca aparecia: o ponto
     * nascia rapido e morria devagar, o que chegou como "inicia bem, finaliza
     * mal". Simetrico, nascer e morrer levam o mesmo tempo.
     */
    --fade: 2.5rem;

    margin-block-start: var(--s8);
    height: var(--altura);
    border-block-start: var(--borda) solid var(--linha);
    background: linear-gradient(180deg, color-mix(in srgb, var(--ciano) 3%, transparent), transparent);

    /*
     * A mascara termina onde o cabecote termina, e nao numa porcentagem fixa.
     *
     * Esta e a correcao da queixa "some antes de chegar ao fim". Com um corte
     * fixo em 78% o ponto chegava a 91.7% da faixa e passava a ultima quarta
     * parte da viagem desaparecendo, porque o traco seguia visivel para alem
     * dele: existia um "fim da linha" que ele nunca alcancava.
     *
     * Amarrando o apagamento ao --fim, o traco acaba junto com o ponto. Nao
     * sobra linha depois dele, entao nao ha como parecer que faltou percurso.
     *
     * Quando o percurso passa da largura da faixa, o gradiente termina fora da
     * caixa e o traco simplesmente vai ate a borda: o ponto sai de cena pela
     * direita, que tambem e chegar ao fim.
     */
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 var(--fade),
      #000 calc(var(--fim) - var(--fade)),
      transparent var(--fim)
    );
  }

  .ecg-svg {
    width: 100%;
    height: 100%;
  }

  .ecg-traco {
    fill: none;
    stroke: var(--menta);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    /*
     * Fraco de proposito: esta e a copia de baixo, que existe so para a faixa
     * nao ficar vazia a frente do cabecote. O contraste entre ela e a copia
     * acesa e o que produz a sensacao de varredura.
     */
    opacity: 0.26;
  }

  .ecg-traco-vivo {
    opacity: 1;
  }

  /*
   * O avanco: a varredura da esquerda para a direita.
   *
   * O traco fica parado e o cabecote corre por cima, que e como funciona um
   * monitor de leito. A versao anterior rolava a fita E corria o ponto ao mesmo
   * tempo, e o deslocamento visivel virava a diferenca entre os dois. Aquela
   * diferenca so podia valer multiplos de 120 unidades, nunca casava com a
   * largura real da janela, e o ponto acabava morrendo no meio da faixa: em um
   * monitor de 1920 ele terminava a 79% da largura, em plena area opaca.
   *
   * A duracao e o numero de ciclos andam sempre juntos, por construcao: um ciclo
   * leva --batida, entao N ciclos levam N vezes --batida. Ha teste que falha se
   * alguem trocar o keyframe sem trocar o --ciclos ao lado.
   */
  .ecg-avanco,
  .ecg-rastro {
    /*
     * As duas variaveis levam valor de reserva. Sem ele, uma var que nao chegue
     * ao elemento invalida a declaracao INTEIRA, e o efeito nao e uma duracao
     * errada: e a animacao deixar de existir, sem nenhum aviso.
     */
    animation: avanco-2 calc(var(--ciclos, 2) * var(--batida, 1.25s)) linear infinite;
  }

  /*
   * Quanto mais larga a faixa, mais ciclos o cabecote precisa atravessar para
   * chegar ate a borda que apaga. Cada ciclo ocupa 168px na tela, sempre, entao
   * os cortes sao a largura util dividida por 168.
   */
  @media (min-width: 28rem) {
    .ecg {
      --ciclos: 3;
    }

    .ecg-avanco,
    .ecg-rastro {
      animation-name: avanco-3;
    }
  }

  @media (min-width: 39rem) {
    .ecg {
      --ciclos: 4;
    }

    .ecg-avanco,
    .ecg-rastro {
      animation-name: avanco-4;
    }
  }

  @media (min-width: 50rem) {
    .ecg {
      --ciclos: 5;
    }

    .ecg-avanco,
    .ecg-rastro {
      animation-name: avanco-5;
    }
  }

  /*
   * Em 60rem a casca troca o recuo lateral de 2x1.5rem para 4.5rem mais 2rem, e
   * a largura util cai de 911px para 856px de uma vez. O corte acompanha essa
   * mudanca em vez de ignora-la.
   */
  @media (min-width: 60rem) {
    .ecg {
      --ciclos: 6;
    }

    .ecg-avanco,
    .ecg-rastro {
      animation-name: avanco-6;
    }
  }

  /*
   * A oscilacao: um ciclo da onda, para sempre, independente da largura.
   *
   * Como o avanco dura um multiplo inteiro disto, o cabecote pisa no mesmo lugar
   * da onda em qualquer tela, sem nenhum ajuste de fase.
   */
  .ecg-cabecote {
    animation: onda var(--batida, 1.25s) linear infinite;
  }

  .ecg-ponto {
    fill: var(--texto);
    /* O nucleo e claro para ler como brasa, nao como um circulo verde chapado. */
    filter: drop-shadow(0 0 3px var(--menta));
  }

  /*
   * O halo respira em brilho, nunca em tamanho.
   *
   * Antes ele inchava ate 2.1 vezes num quadro especifico do ciclo, e como a
   * volta do cabecote era mais longa que a da fita, isso saia como dois estouros
   * secos em pontos sempre iguais da linha. Variar so a opacidade, num vaivem
   * continuo, da a respiracao sem o susto.
   *
   * A duracao e proposital: 4.4s nao e multiplo nem divisor de 1.25s, entao a
   * respiracao nunca cai duas vezes no mesmo lugar do traco.
   */
  .ecg-halo {
    fill: var(--menta);
    animation: respirar 4.4s ease-in-out infinite;
  }

  @keyframes respirar {
    0%,
    100% {
      opacity: 0.16;
    }
    50% {
      opacity: 0.36;
    }
  }

  /*
   * Movimento reduzido, separando o que incomoda do que nao incomoda.
   *
   * O que para: a cascata de energizacao. Ela acende trinta e seis trilhas em
   * sequencia logo no carregamento, puxa o olho e e o unico movimento grande do
   * hero. Com a preferencia ligada o simbolo simplesmente aparece pronto.
   *
   * O que fica: o ECG e o pulso do kicker. Nenhum dos dois desloca elemento na
   * tela. Um e um ponto de 2.4px que atravessa a faixa devagar, o outro e um
   * brilho que expande oito pixels e some. A preferencia existe por causa de
   * desconforto vestibular, causado por deslocamento amplo, parallax e zoom, e
   * nao por um sinal fino correndo no rodape do hero. Parar tudo custava a
   * assinatura da pagina sem devolver conforto a ninguem.
   *
   * O meio termo e a cadencia, e agora ela e um numero so: dobrar --batida
   * desacelera a onda e o avanco na mesma proporcao, sem chance de tirar os dois
   * de fase. Era exatamente esse o erro que existia aqui quando cada animacao
   * carregava a propria duracao.
   */
  @media (prefers-reduced-motion: reduce) {
    .hero-marca :global(.sl-trace) {
      opacity: 1;
      animation: none !important;
    }

    .hero-marca :global(#sl-core) {
      animation: none !important;
    }

    .hero-ponto {
      animation-duration: 4.8s !important;
      animation-iteration-count: infinite !important;
    }

    /*
     * Movimento reduzido nao ganha uma versao lenta, ganha uma versao parada.
     *
     * Desacelerar era inutil e enganoso. Medido no Chrome do dono, com o Windows
     * de "Efeitos de animacao" desligado: o navegador forca animation-duration
     * para 1e-06s em toda animacao CSS, entao a --batida de 2.5s daqui nunca
     * chegava a valer nada. O resultado na tela era um ECG travado no primeiro
     * quadro, com o cabecote parado em x=0, bem na borda que a mascara apaga,
     * o que le como defeito e nao como decisao.
     *
     * Parando de proposito, o traco fica inteiro e o cabecote descansa sobre a
     * linha de base a dois ciclos da partida, longe das duas bordas. Vira um
     * monitor em pausa, que e uma imagem honesta.
     *
     * Um ciclo, e nao a metade do percurso, por duas razoes. A onda so volta a
     * linha de base a cada 120 unidades, entao parar num deslocamento qualquer
     * deixaria o ponto flutuando ao lado do traco em vez de em cima dele. E um
     * ciclo cabe em TODA largura: a faixa mais estreita percorre dois, entao
     * parar em dois a colocaria exatamente no fim do percurso, dentro da borda
     * que a mascara apaga, que e o defeito que este bloco existe para evitar.
     */
    .ecg-avanco,
    .ecg-rastro {
      animation: none;
      translate: calc(var(--fim) / var(--ciclos));
    }

    .ecg-cabecote {
      animation: none;
      translate: 0 20px;
    }

    .ecg-halo {
      animation-duration: 8.8s !important;
      animation-iteration-count: infinite !important;
    }
  }
</style>
