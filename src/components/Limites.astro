---
/**
 * O que eu nao faco.
 *
 * Seção curta e de propósito negativa. Dizer o que o serviço não faz filtra o
 * cliente errado antes da primeira conversa, e é a parte da página que mais
 * economiza tempo dos dois lados.
 */
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = ui[Astro.props.locale].limites;
---

<section class="secao" id="limites">
  <div class="casca">
    <p class="rotulo"><b>{t.codigo}</b> {t.rotulo}</p>
    <h2 class="titulo-secao">{t.titulo}</h2>

    <ul class="limites">
      {
        t.itens.map((item) => (
          <li class="limite">
            <svg class="limite-icone" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.4" />
              <path d="M6.5 6.5 13.5 13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
            <div>
              <h3 class="limite-titulo">{item.titulo}</h3>
              <p class="limite-texto">{item.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .limites {
    margin-block-start: var(--s7);
    display: grid;
    gap: var(--s5);
  }

  @media (min-width: 52rem) {
    .limites {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s6);
    }
  }

  .limite {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: var(--s4);
  }

  .limite-icone {
    margin-block-start: 0.2rem;
    color: var(--texto-3);
    flex: none;
  }

  .limite-titulo {
    font-size: 1.0625rem;
    font-stretch: 102%;
  }

  .limite-texto {
    margin-block-start: var(--s2);
    font-size: 0.9375rem;
    color: var(--texto-2);
    max-width: 46ch;
  }
</style>
