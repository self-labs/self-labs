---
/**
 * Trilha de PCB, o elemento estrutural da pagina.
 *
 * Corre pela lateral esquerda e carrega uma via por secao. A via nao e enfeite:
 * e um link de ancora, e o conjunto funciona como indice de progresso. Quando a
 * secao ativa muda, um pulso percorre o trecho da trilha ate a via nova.
 *
 * Em telas estreitas a coluna some e sobra uma barra de progresso de 2px no
 * topo, que e a mesma informacao no espaco disponivel.
 */
import type { Locale } from '../i18n/ui';

interface Secao {
  id: string;
  rotulo: string;
}

interface Props {
  secoes: readonly Secao[];
  locale: Locale;
}

const { secoes } = Astro.props;
---

<aside class="trilha" aria-hidden="true">
  <!--
    O nucleo agrupa o fio e as vias. Solto na trilha fixa, o svg herdava a altura
    da janela e o fio corria de ponta a ponta da tela enquanto os aneis ocupavam
    pouco mais de 200px no centro: uma linha de fora a fora que nao pertencia a
    nada. Agrupados, o fio mede o conjunto que ele liga, que e o que uma trilha
    de placa faz.
  -->
  <div class="trilha-nucleo">
  <svg class="trilha-svg" viewBox="0 0 24 100" preserveAspectRatio="none" focusable="false">
    <defs>
      <!--
        userSpaceOnUse, e nao o padrao objectBoundingBox: uma <line> vertical tem
        caixa de largura zero, e um gradiente em coordenadas relativas a ela nao
        pinta nada. A trilha ficou tempo nenhum na tela por causa disso, e o que
        se via eram cinco aneis soltos, sem fio ligando um ao outro.
      -->
      <linearGradient id="trilha-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="100">
        <stop offset="0%" stop-color="#0BE4EB" stop-opacity="0" />
        <stop offset="22%" stop-color="#0BE4EB" stop-opacity="0.55" />
        <stop offset="78%" stop-color="#3AF2A8" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#3AF2A8" stop-opacity="0" />
      </linearGradient>
    </defs>
    <line x1="12" y1="0" x2="12" y2="100" stroke="url(#trilha-grad)" stroke-width="1.75" vector-effect="non-scaling-stroke" />
  </svg>

  <ol class="vias">
    {
      secoes.map((s, i) => (
        <li class="via-item">
          <a class="via" href={`#${s.id}`} data-via={s.id} aria-hidden="true" tabindex="-1">
            <span class="via-anel" />
            <span class="via-rotulo">
              <span class="via-num">{String(i + 1).padStart(2, '0')}</span>
              {s.rotulo}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  </div>
</aside>

<div class="progresso" aria-hidden="true"><span class="progresso-barra"></span></div>

<style>
  .trilha {
    display: none;
  }

  /*
   * Fio de progresso. Com a barra de rolagem do navegador oculta, ele deixa de
   * ser reforco e passa a ser o unico indicador continuo de posicao, entao fica
   * visivel em qualquer largura, e nao so no celular.
   */
  .progresso {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    height: 2px;
    z-index: 60;
    background: color-mix(in srgb, var(--ciano) 8%, transparent);
  }

  .progresso-barra {
    display: block;
    height: 100%;
    width: var(--avanco, 0%);
    background: linear-gradient(90deg, var(--ciano), var(--menta));
    transition: width 90ms linear;
  }

  @media (min-width: 60rem) {
    .trilha {
      display: block;
      position: fixed;
      inset-block: 0;
      inset-inline-start: max(0px, calc((100vw - var(--largura)) / 2));
      width: var(--gutter);
      z-index: 30;
      pointer-events: none;
    }

    /*
     * O nucleo e quem fica centralizado, e a altura dele sai das proprias vias.
     * Antes o svg e a lista se posicionavam cada um por conta, e so a lista
     * media o conteudo: o fio nao tinha como saber onde o conjunto comecava.
     */
    .trilha-nucleo {
      position: absolute;
      inset-block-start: 50%;
      translate: 0 -50%;
      inset-inline-start: 1.5rem;
    }

    .trilha-svg {
      position: absolute;
      /*
       * O fio entra antes do primeiro anel e sai depois do ultimo, em vez de
       * nascer colado neles.
       *
       * A altura precisa ser declarada. Um <svg> e elemento substituido, entao
       * fixar inset-block nas duas pontas NAO o estica: ele cai na altura
       * intrinseca do proprio viewBox, que aqui e 24 por 100, e com 1.5rem de
       * largura isso da 100px. Medido: o fio cobria os primeiros 100px de um
       * conjunto de 216 e parava no meio da terceira via.
       */
      inset-block-start: calc(var(--s7) * -1);
      height: calc(100% + var(--s7) * 2);
      inset-inline-start: 0;
      width: 1.5rem;
    }

    .vias {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--s5);
      pointer-events: auto;
    }

    .via {
      position: relative;
      display: flex;
      align-items: center;
      height: 1.5rem;
      width: 1.5rem;
    }

    /*
     * A via em si: o furo metalizado que liga duas camadas da placa.
     *
     * E um grid com um item so, e nao um bloco com pseudo-elemento posicionado.
     * Posicionar por "50% + translate(-50%)" ancora no padding box, que a borda
     * de 1.5px desloca, e ainda cai em meio pixel num ponto de tamanho impar: o
     * resultado e um miolo visivelmente torto. Com place-content o item fica no
     * centro exato da caixa de conteudo, que e concentrica ao anel por
     * construcao, sem conta nenhuma para arredondar.
     */
    .via-anel {
      display: grid;
      place-content: center;
      position: relative;
      inset-inline-start: 0.375rem;
      width: 0.75rem;
      height: 0.75rem;
      border: 1.5px solid color-mix(in srgb, var(--ciano) 32%, transparent);
      border-radius: 50%;
      background: var(--base);
      transition: border-color var(--medio) var(--curva), box-shadow var(--medio) var(--curva);
    }

    .via-anel::after {
      content: '';
      width: 0.25rem;
      height: 0.25rem;
      border-radius: 50%;
      background: var(--ciano);
      opacity: 0;
      transform: scale(0.4);
      transition: opacity var(--medio) var(--curva), transform var(--medio) var(--curva);
    }

    .via-rotulo {
      position: absolute;
      /*
       * Sem isto o rotulo, mesmo invisivel, continua recebendo ponteiro e cobre
       * 79px da coluna de conteudo: cliques em cards perto da lateral esquerda
       * caiam nele. Ele aparece por hover no ancestral, entao nao precisa ser
       * alvo de nada.
       */
      pointer-events: none;
      inset-inline-start: 1.75rem;
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      white-space: nowrap;
      font-family: var(--mono);
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--texto-2);
      background: color-mix(in srgb, var(--base) 92%, transparent);
      padding: 0.25rem 0.5rem;
      border-radius: var(--raio);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity var(--medio) var(--curva), transform var(--medio) var(--curva);
    }

    .via-num {
      color: var(--texto-3);
    }

    .via:hover .via-rotulo,
    .via:focus-visible .via-rotulo {
      opacity: 1;
      transform: translateX(0);
    }

    .via[aria-current='true'] .via-anel {
      border-color: var(--menta);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--menta) 12%, transparent);
    }

    .via[aria-current='true'] .via-anel::after {
      background: var(--menta);
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

<script>
  /**
   * Ilha 1 de 3: acende a via da secao atual e move o fio de progresso.
   *
   * A decisao de qual via acender e GEOMETRICA, e nao por IntersectionObserver.
   *
   * A versao com observador errava a secao em 40.5% da rolagem, por tres razoes
   * que se somavam. A margem de recorte de 45% fazia a via trocar quase meia
   * tela antes de a secao chegar. Quando nenhuma secao intersectava a faixa
   * central, nenhuma entrada chegava e a via anterior ficava acesa indevidamente,
   * inclusive no topo da pagina. E o desempate por intersectionRatio nunca
   * chegava a rodar, porque com aquela margem so uma secao intersecta por vez.
   *
   * Perguntar "qual secao contem o meio da janela" responde certo sempre, custa
   * uma passada por uma lista de oito, e roda no mesmo quadro que ja atualiza o
   * fio de progresso.
   */
  const vias = document.querySelectorAll<HTMLAnchorElement>('[data-via]');
  const barra = document.querySelector<HTMLElement>('.progresso');

  /*
   * A pagina tem oito secoes com ancora e a trilha mostra cinco marcos. As tres
   * que sobram pertencem visualmente a um marco vizinho, e sem este mapa elas
   * simplesmente nao acendiam nada: o portfolio completo continua sendo
   * "projetos", os limites vem logo depois de "producao", e a validacao externa
   * antecede "contato".
   */
  const VIA_DA_SECAO: Record<string, string> = {
    lab: 'lab',
    metodo: 'metodo',
    projetos: 'projetos',
    arquivo: 'projetos',
    producao: 'producao',
    limites: 'producao',
    externo: 'contato',
    contato: 'contato',
  };

  const secoes = [...document.querySelectorAll<HTMLElement>('section[id]')].filter((s) => VIA_DA_SECAO[s.id]);

  const acender = (via: string | null) => {
    for (const v of vias) {
      // O estado tambem e APAGADO quando nenhuma secao esta em foco, coisa que a
      // versao anterior nunca fazia: no topo da pagina ficava aceso o marco da
      // ultima visita.
      v.setAttribute('aria-current', String(via !== null && v.dataset.via === via));
    }
  };

  let agendado = false;

  const atualizar = () => {
    agendado = false;

    if (barra) {
      const rolavel = document.documentElement.scrollHeight - window.innerHeight;
      const razao = rolavel > 0 ? Math.min(1, window.scrollY / rolavel) : 0;
      barra.style.setProperty('--avanco', `${(razao * 100).toFixed(2)}%`);
    }

    if (vias.length === 0 || secoes.length === 0) return;

    // O meio da janela e o ponto de leitura: e o que a pessoa esta de fato lendo.
    const meio = window.scrollY + window.innerHeight / 2;
    let atual: string | null = null;
    for (const secao of secoes) {
      const topo = secao.getBoundingClientRect().top + window.scrollY;
      if (topo <= meio) atual = VIA_DA_SECAO[secao.id];
    }
    acender(atual);
  };

  const agendarMedida = () => {
    if (agendado) return;
    agendado = true;
    requestAnimationFrame(atualizar);
  };

  {
    addEventListener('scroll', agendarMedida, { passive: true });

    /*
     * A altura da pagina muda sem ninguem rolar: o filtro do portfolio esconde
     * cards e o redimensionamento reflui tudo. Sem observar isso, o fio ficava
     * marcando a proporcao antiga ate a proxima rolagem.
     */
    addEventListener('resize', agendarMedida, { passive: true });
    new ResizeObserver(agendarMedida).observe(document.documentElement);

    atualizar();
  }

  /**
   * Ilha 3 de 3: navegacao ponto a ponto entre secoes.
   *
   * Usa o scroll suave NATIVO, nao uma animacao quadro a quadro em
   * requestAnimationFrame. A primeira versao daqui animava a mao, e isso tem um
   * defeito que so aparece no aparelho de verdade: o rAF e estrangulado quando a
   * aba perde foco, quando o aparelho entra em economia de bateria ou quando o
   * navegador esta sob carga. Medido neste projeto num ambiente estrangulado, o
   * rAF caiu para 1 quadro por segundo, e a animacao de 900ms virou dois saltos.
   * O scroll nativo roda no compositor do navegador e nao sofre disso.
   *
   * O JavaScript aqui existe por tres motivos que o CSS sozinho nao cobre:
   * descontar a altura do cabecalho de forma explicita, desligar o encaixe
   * durante a viagem, e atualizar a URL sem provocar o pulo do navegador.
   */
  (() => {
    const html = document.documentElement;
    const suportaSuave = 'scrollBehavior' in html.style;
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)');

    /**
     * Anima a rolagem quadro a quadro.
     *
     * Existe para um caso so: quando o sistema pede movimento reduzido, o Chrome
     * converte "behavior: smooth" em salto instantaneo, enquanto o Safari anima
     * assim mesmo. Os dois estao certos, a especificacao deixa a decisao para o
     * navegador, e o resultado e a mesma pagina se comportando diferente em cada
     * um. Aqui a rolagem de navegacao e tratada como orientacao, nao decoracao,
     * entao ela anima nos dois.
     *
     * O custo esta assumido: rAF e estrangulado com a aba fora de foco, sob
     * economia de bateria ou carga alta, e nesse caso a viagem degrada para
     * poucos quadros. Por isso este caminho e a excecao, e nao o padrao.
     */
    let quadro = 0;
    const animar = (destino: number) => {
      cancelAnimationFrame(quadro);
      const partida = window.scrollY;
      const distancia = destino - partida;
      if (Math.abs(distancia) < 2) {
        window.scrollTo(0, destino);
        return;
      }

      // Cresce com a raiz da distancia e para em 900ms, senao atravessar a
      // pagina inteira viraria uma viagem de varios segundos.
      const duracao = Math.min(900, Math.max(320, Math.sqrt(Math.abs(distancia)) * 26));
      const inicio = performance.now();
      const suavizar = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

      const passo = (agora: number) => {
        const t = Math.min(1, (agora - inicio) / duracao);
        // "instant" e explicito: sem isso a chamada herdaria o scroll-behavior
        // smooth do html e uma animacao nativa competiria com esta, quadro a
        // quadro, justamente no navegador que este caminho existe para atender.
        window.scrollTo({ top: partida + distancia * suavizar(t), behavior: 'instant' });
        if (t < 1) quadro = requestAnimationFrame(passo);
      };
      quadro = requestAnimationFrame(passo);
    };

    const parar = () => cancelAnimationFrame(quadro);

    /*
     * O gesto da pessoa vence a animacao, mas so o gesto que de fato rola.
     *
     * A versao anterior cancelava em qualquer keydown, e isso foi medido como
     * defeito grave: apertar Shift, Ctrl ou Tab durante a viagem congelava a
     * pagina no meio do caminho, uma vez a 1.8% do destino, com a URL ja
     * apontando para a secao. Segurar uma tecla modificadora e algo que se faz
     * sem pensar, e quem mais sofria era justamente quem navega por teclado.
     *
     * "touchmove" e nao "touchstart" pela mesma razao: encostar no link nao e
     * rolar, arrastar o dedo e.
     */
    const TECLAS_QUE_ROLAM = new Set([
      'ArrowUp',
      'ArrowDown',
      'PageUp',
      'PageDown',
      'Home',
      'End',
      ' ',
      'Spacebar',
    ]);

    addEventListener('wheel', parar, { passive: true });
    addEventListener('touchmove', parar, { passive: true });
    addEventListener(
      'keydown',
      (evento) => {
        if (TECLAS_QUE_ROLAM.has(evento.key)) parar();
      },
      { passive: true },
    );

    /*
     * A folga vem da propria secao de destino (scroll-margin-top), que e a unica
     * fonte dela desde que o scroll-padding-top saiu do html. Ler daqui garante
     * que o destino do JavaScript e o ponto de encaixe do CSS sejam o mesmo
     * numero, e nao dois que se somam.
     */
    const folgaAncora = (secao: HTMLElement) =>
      Number.parseFloat(getComputedStyle(secao).scrollMarginTop) || 88;

    let restaurarEncaixe = 0;

    const destinoDe = (secao: HTMLElement) =>
      Math.max(
        0,
        Math.min(
          secao.getBoundingClientRect().top + window.scrollY - folgaAncora(secao),
          html.scrollHeight - window.innerHeight,
        ),
      );

    const irPara = (secao: HTMLElement) => {
      const destino = destinoDe(secao);

      /*
       * Sem suporte a rolagem suave nao ha o que animar: vai direto.
       */
      if (!suportaSuave) {
        window.scrollTo(0, destino);
        return;
      }

      /*
       * O encaixe por proximidade briga com a rolagem em curso e pode puxar a
       * pagina para o marco anterior no meio do caminho. Sai de cena durante a
       * viagem e volta depois. O tempo e generoso porque nao ha evento confiavel
       * de "a rolagem suave terminou" em todos os navegadores.
       */
      clearTimeout(restaurarEncaixe);
      html.style.scrollSnapType = 'none';
      restaurarEncaixe = window.setTimeout(() => {
        html.style.scrollSnapType = '';
      }, 1200);

      /*
       * Duas rotas, e a escolha depende do que o navegador faria com a
       * preferencia de movimento reduzido.
       *
       * Sem a preferencia ligada, o caminho nativo e melhor: roda no compositor,
       * nao depende de requestAnimationFrame e nao degrada quando a aba perde
       * foco ou o aparelho entra em economia de bateria.
       *
       * Com a preferencia ligada, o Chrome converte "behavior: smooth" em salto
       * instantaneo, enquanto o Safari anima assim mesmo. Como a rolagem aqui e
       * orientacao e nao decoracao, o quadro a quadro assume nesse caso, e a
       * pagina se comporta igual nos dois navegadores.
       */
      if (semMovimento.matches) {
        animar(destino);
        return;
      }

      window.scrollTo({ top: destino, behavior: 'smooth' });
    };

    // Vale para o menu do cabecalho, para o menu do celular, para as vias da
    // trilha e para os botoes do hero: qualquer link que aponte para uma ancora.
    addEventListener('click', (evento) => {
      /*
       * Sai cedo no que nao e um clique simples de navegacao. Sem isto, um
       * Ctrl+clique ou Cmd+clique num item do menu deixava de abrir nova aba,
       * porque o preventDefault vinha antes de qualquer verificacao.
       */
      if (evento.defaultPrevented || evento.button !== 0) return;
      if (evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;

      const link = (evento.target as HTMLElement)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
      if (!link) return;

      /*
       * O link de pular para o conteudo fica de fora. Ele existe para MOVER O
       * FOCO, e nao para rolar: interceptado aqui, ele deixava de cumprir a
       * unica funcao que tem, e a pagina continuava com o foco no mesmo lugar.
       */
      if (link.classList.contains('pular')) return;

      const id = link.getAttribute('href')!.slice(1);
      if (!id) return;

      const secao = document.getElementById(id);
      if (!secao) return;

      evento.preventDefault();
      irPara(secao);

      /*
       * O foco acompanha a pagina, senao quem navega por teclado continua no
       * cabecalho depois de escolher uma secao. "preventScroll" e obrigatorio
       * aqui: sem ele o navegador salta para o elemento e mata a animacao que
       * acabou de comecar.
       */
      secao.setAttribute('tabindex', '-1');
      secao.focus({ preventScroll: true });

      /*
       * replaceState, e nao pushState: cada clique empilhava uma entrada de
       * historico mesmo quando a pagina nem se movia, e voltar exigia apertar o
       * botao tantas vezes quantos cliques tivessem sido dados.
       */
      if (location.hash !== `#${id}`) history.replaceState(null, '', `#${id}`);
    });

    /*
     * Chegada por fragmento, seja no carregamento, seja pelo botao voltar ou
     * avancar, seja editando o hash na barra de enderecos. Sem tratar popstate e
     * hashchange, o botao avancar mudava a URL sem mover a pagina.
     */
    const irParaOHash = (animado: boolean) => {
      if (location.hash.length <= 1) return;
      const alvo = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (!alvo) return;
      if (animado) irPara(alvo);
      else requestAnimationFrame(() => window.scrollTo({ top: destinoDe(alvo), behavior: 'instant' }));
    };

    addEventListener('popstate', () => irParaOHash(true));
    addEventListener('hashchange', () => irParaOHash(true));
    irParaOHash(false);
  })();
</script>
