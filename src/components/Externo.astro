---
/**
 * Validacao externa: codigo que passou pela revisao de outra pessoa.
 *
 * Portfolio proprio prova gosto. Pull request aceito no repositorio de terceiro
 * prova que o codigo sobreviveu a um revisor que nao tinha motivo para ser gentil.
 */
import { ui, type Locale } from '../i18n/ui';
import stats from '../data/stats.json';

interface Props {
  locale: Locale;
}

const t = ui[Astro.props.locale].externo;
---

<section class="secao" id="externo">
  <div class="casca">
    <p class="rotulo"><b>{t.codigo}</b> {t.rotulo}</p>
    <h2 class="titulo-secao">{t.titulo}</h2>
    <p class="subtitulo-secao">{t.subtitulo(stats.prsExternos)}</p>

    <ul class="externos">
      {
        t.itens.map((item) => (
          <li class="externo">
            <a class="externo-link" href={item.link} rel="noopener">
              <h3 class="externo-onde">
                {item.onde}
                <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true">
                  <path
                    d="M5.5 10.5 10.5 5.5M6.5 5.5h4v4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="square"
                  />
                </svg>
              </h3>
              <p class="externo-texto">{item.texto}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .externos {
    margin-block-start: var(--s7);
    display: grid;
    gap: 0;
  }

  .externo {
    border-block-start: var(--borda) solid var(--linha);
  }

  .externo:last-child {
    border-block-end: var(--borda) solid var(--linha);
  }

  .externo-link {
    display: block;
    padding-block: var(--s5);
    transition: background var(--rapido) var(--curva);
  }

  .externo-link:hover {
    background: color-mix(in srgb, var(--ciano) 4%, transparent);
  }

  .externo-onde {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ciano);
  }

  .externo-onde svg {
    color: var(--texto-3);
    transition: color var(--rapido) var(--curva), transform var(--rapido) var(--curva);
  }

  .externo-link:hover svg {
    color: var(--ciano);
    transform: translate(1px, -1px);
  }

  .externo-texto {
    margin-block-start: var(--s3);
    max-width: 74ch;
    color: var(--texto-2);
  }
</style>
