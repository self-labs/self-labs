{
  "name": "self-labs",
  "version": "2026.8.12",
  "private": true,
  "type": "module",
  "description": "Landing page institucional do Self-Labs",
  "scripts": {
    "brand": "node scripts/build-brand.mjs",
    "dev": "astro dev",
    "build": "npm run brand && node scripts/fetch-stats.mjs && astro build && node scripts/build-og.mjs && node scripts/build-headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "npm run check && npm run test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/manrope": "^5.2.5",
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.30.0"
  },
  "engines": {
    "node": ">=22"
  }
}
