# --- Logs ---
*.log
npm-debug.log*

# --- Grafo de conhecimento: derivado, regenerável e volumoso ---
graphify-out/

# --- Dados sensíveis ---
# Propostas, orçamentos e relatórios gerados a partir do modelo Self-Labs
# carregam nome de cliente, endereço do local, valores negociados, contato de
# terceiros e a topologia da rede instalada. Este repositório é PÚBLICO: nada
# disso pode entrar na história do git, em nenhum formato. Um arquivo que chega
# ao histórico continua lá depois de apagado, então a regra vem antes do arquivo.
propostas/
relatorios/

# --- Testes e cobertura ---
coverage/

# --- Artefatos de ferramentas e previews ---
.eslintcache
.cache/
.playwright-mcp/
# Marca copiada ao lado de cada documento pelo new-selflabs-doc.ps1. Derivada de
# src/assets/brand, regenerável, e nunca versionada duas vezes.
selflabs-assets/

